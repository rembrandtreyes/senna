{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design review deck",
  "description": "Data for review-deck.template.html. Produced by build.mjs from narrative.json (narrative agent) and diagram.src.json (diagram agent).",
  "type": "object",
  "required": [
    "meta",
    "summary",
    "problem",
    "diagram",
    "architecture"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "kind",
        "version",
        "updated",
        "prd",
        "status",
        "ask"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "prd": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ask": {
          "type": "string",
          "description": "The decision this review needs, one sentence."
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "problem": {
      "type": "object",
      "required": [
        "statement",
        "metrics",
        "requirements",
        "nonGoals"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "from",
              "to",
              "window"
            ]
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R-\\d+$"
              }
            }
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": [
        "viewBox",
        "nodes",
        "edges"
      ],
      "properties": {
        "viewBox": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "sub",
              "x",
              "y",
              "w",
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "existing",
                  "new"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "d",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*-[a-z][a-z0-9_]*$",
                "description": "<from>-<to> node ids; generated by build.mjs"
              },
              "mode": {
                "enum": [
                  "before",
                  "after",
                  "both"
                ]
              },
              "dashed": {
                "type": "boolean"
              },
              "ghost": {
                "type": "boolean"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "before",
        "after"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tone",
          "steps"
        ],
        "properties": {
          "tone": {
            "enum": [
              "allow",
              "throttle",
              "reject"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "text"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "reverse": {
                  "type": "boolean"
                },
                "tone": {
                  "enum": [
                    "allow",
                    "throttle",
                    "reject"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "meter": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "stateLabel": {
            "type": "string",
            "description": "Optional state panel label (e.g. \"Delivery attempts\")."
          }
        }
      }
    },
    "alternatives": {
      "type": "object",
      "required": [
        "criteria",
        "options"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "likelihood",
          "impact",
          "mitigation"
        ],
        "properties": {
          "likelihood": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "impact": {
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      }
    },
    "rollout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "length",
          "detail",
          "gate",
          "rollback"
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "owner"
        ]
      }
    },
    "sections": {
      "type": "array",
      "description": "Section order; ids or {id, nav, title}. Default: all. Sections with no data are skipped.",
      "items": {
        "anyOf": [
          {
            "enum": [
              "overview",
              "changes",
              "problem",
              "architecture",
              "flows",
              "alternatives",
              "risks",
              "rollout",
              "questions"
            ]
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "enum": [
                  "overview",
                  "changes",
                  "problem",
                  "architecture",
                  "flows",
                  "alternatives",
                  "risks",
                  "rollout",
                  "questions"
                ]
              },
              "nav": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "changes": {
      "type": "object",
      "required": [
        "since",
        "items"
      ],
      "description": "What changed since the last reviewed version; drives the What changed section and nav markers.",
      "properties": {
        "since": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "section",
              "text"
            ],
            "properties": {
              "section": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "feedback": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F-\\d+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
