{
  "extraKnownMarketplaces": {
    "senna": {
      "source": { "source": "github", "repo": "rembrandtreyes/senna" }
    }
  },
  "enabledPlugins": {
    "core@senna": true,
    "plan@senna": true,
    "lang-ts@senna": true,
    "lang-go@senna": false,
    "lang-rust@senna": false,
    "ops@senna": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
