// plugins/plan: route -> PRD -> spec -> present -> design review
model {
  extend harness {
    plan = service 'plan plugin' {
      description 'Planning pipeline for features and projects, before any code is written'
      technology 'skills, subagents, Node'
      link ../plugins/plan 'code'

      // Skills
      route = component 'route' {
        description 'Classifies new work as bug, small task, feature, or project, and waits for confirmation'
        technology 'skill'
        link ../plugins/plan/skills/route/SKILL.md 'code'
      }
      prd = component '/prd' {
        description 'One-question-at-a-time interview that writes prd.md, gated by prd-critic'
        technology 'skill'
        link ../plugins/plan/skills/prd/SKILL.md 'code'
      }
      spec = component '/spec' {
        description 'Runs 2-3 designers, records the winner and ADRs, gated by spec-critic'
        technology 'skill'
        link ../plugins/plan/skills/spec/SKILL.md 'code'
      }
      present = component '/present' {
        description 'Builds the review deck from the spec and loops visual QA until clean'
        technology 'skill'
        link ../plugins/plan/skills/present/SKILL.md 'code'
      }
      publish = component '/publish' {
        description 'Publishes a deck through an adapter (artifact, static, vercel) and records it in publish.json'
        technology 'skill'
        link ../plugins/plan/skills/publish/SKILL.md 'code'
      }
      feedback = component '/feedback' {
        description 'Pulls reviewer feedback from every source into feedback.md, triages it, writes back, runs sign-off'
        technology 'skill'
        link ../plugins/plan/skills/feedback/SKILL.md 'code'
      }
      adapters = component 'publish adapters' {
        description 'artifact, static, vercel: how to publish, collect feedback, and write statuses back'
        technology 'markdown'
        link ../plugins/plan/adapters 'code'
      }
      feedbackScript = component 'feedback.mjs' {
        description 'Normalizes deck exports and PR comments, dedupes against the ledger, assigns the next F-ID'
        technology 'Node, gh'
        link ../plugins/plan/scripts/feedback.mjs 'code'
      }
      designReview = component '/design-review' {
        description 'Runs the reviewer lenses in parallel and records findings in feedback.md'
        technology 'skill'
        link ../plugins/plan/skills/design-review/SKILL.md 'code'
      }

      // Subagents
      prdCritic = component 'prd-critic' {
        description 'Read-only PASS/FAIL gate on prd.md'
        technology 'subagent'
        link ../plugins/plan/agents/prd-critic.md 'code'
      }
      designer = component 'designer' {
        description 'Produces one candidate design for a given stance (minimal, robust, different shape)'
        technology 'subagent'
        link ../plugins/plan/agents/designer.md 'code'
      }
      specCritic = component 'spec-critic' {
        description 'Read-only PASS/FAIL gate on spec.md, including a cold read'
        technology 'subagent'
        link ../plugins/plan/agents/spec-critic.md 'code'
      }
      lenses = component 'reviewer lenses' {
        description 'architecture-reviewer, sre-reviewer, product-reviewer: read-only design critiques'
        technology 'subagents'
        link ../plugins/plan/agents 'code'
      }
      deckNarrator = component 'deck-narrator' {
        description 'Writes the deck text (narrative.json) from the spec and PRD'
        technology 'subagent'
        link ../plugins/plan/agents/deck-narrator.md 'code'
      }
      deckDiagrammer = component 'deck-diagrammer' {
        description 'Places model elements on a grid (layout.json), or writes diagram.src.json when there is no model'
        technology 'subagent'
        link ../plugins/plan/agents/deck-diagrammer.md 'code'
      }
      visualQa = component 'visual-qa' {
        description 'Reads screenshots and the QA report, fixes the deck JSON, rebuilds (up to 3 rounds)'
        technology 'subagent'
        link ../plugins/plan/agents/visual-qa.md 'code'
      }

      // Hooks
      planSessionStart = component 'plan session-start.sh' {
        description 'Reports each spec in progress: status, deck stale or unpublished, open feedback, sign-off'
        technology 'SessionStart hook, bash'
        link ../plugins/plan/hooks/scripts/session-start.sh 'code'
      }
      stepGate = component 'step-gate.sh' {
        description 'Blocks the stop once when a PRD or spec in review or approved has no critic PASS for its current content'
        technology 'Stop hook, bash'
        link ../plugins/plan/hooks/scripts/step-gate.sh 'code'
      }
      deckStale = component 'deck-stale.sh' {
        description 'After an edit to spec.md or model/*.c4, tells Claude once per build that the deck is stale'
        technology 'PostToolUse hook, bash'
        link ../plugins/plan/hooks/scripts/deck-stale.sh 'code'
      }

      // Renderer
      build = component 'build.mjs' {
        description 'Merges deck JSON, lays out the diagram, validates the schema, renders index.html'
        technology 'Node, no dependencies'
        link ../plugins/plan/skills/present/renderer/build.mjs 'code'
      }
      model = component 'model.mjs' {
        description 'Exports the LikeC4 proposal: Mermaid flows into spec.md, deck diagram from layout.json'
        technology 'Node, likec4 CLI'
        link ../plugins/plan/scripts/model.mjs 'code'
      }
      qa = component 'qa.mjs' {
        description 'Screenshots the deck in light/dark at 1440 and 390px and runs layout checks'
        technology 'Node, playwright-core'
        link ../plugins/plan/skills/present/renderer/qa.mjs 'code'
      }
    }
  }

  claudeCode -> harness.plan.route 'any new request'
  claudeCode -> harness.plan.designReview '/design-review'

  // Routing
  harness.plan.route -> harness.core.debugger 'bug'
  harness.plan.route -> harness.core.breakdown 'small task'
  harness.plan.route -> harness.plan.prd 'feature or project'

  // PRD
  harness.plan.prd -> harness.core.explorer 'dispatches'
  harness.plan.prd -> harness.plan.prdCritic 'gates on (up to 3 rounds)'
  harness.plan.prd -> project.specs 'writes prd.md'
  harness.plan.prd -> harness.plan.spec 'suggests next'

  // Spec
  harness.plan.spec -> harness.core.explorer 'dispatches'
  harness.plan.spec -> harness.plan.designer 'dispatches 2-3 in parallel'
  harness.plan.spec -> harness.plan.specCritic 'gates on (up to 3 rounds)'
  harness.plan.spec -> harness.ops.apiContracts 'uses for the API section' { style { line dashed } }
  harness.plan.spec -> project.specs 'writes spec.md, adr/, model/'
  harness.plan.spec -> harness.plan.model 'runs flows (Mermaid into spec.md)'
  harness.plan.spec -> harness.plan.present 'suggests next'
  harness.plan.spec -> harness.core.breakdown 'build stage, after approval'

  // Present
  harness.plan.present -> harness.plan.deckNarrator 'dispatches'
  harness.plan.present -> harness.plan.deckDiagrammer 'dispatches'
  harness.plan.present -> harness.plan.build 'runs'
  harness.plan.present -> harness.plan.publish 'suggests next'
  harness.plan.publish -> harness.plan.adapters 'follows Publish'
  harness.plan.publish -> claudeAi 'publishes deck (artifact adapter)'
  harness.plan.publish -> vercel 'deploys preview (vercel adapter)'
  harness.plan.publish -> project.specs 'writes deck/publish.json'
  harness.plan.feedback -> harness.plan.adapters 'follows Collect, Write back'
  harness.plan.feedback -> claudeAi 'reads db and comments, writes statuses'
  harness.plan.feedback -> github 'reads PR review comments' { style { line dashed } }
  harness.plan.feedback -> harness.plan.feedbackScript 'runs pending'
  harness.plan.feedback -> project.specs 'writes feedback.md, sets spec approved'
  harness.plan.feedback -> harness.core.breakdown 'suggests after sign-off'
  claudeCode -> harness.plan.planSessionStart 'SessionStart'
  claudeCode -> harness.plan.deckStale 'PostToolUse (Edit, Write)'
  harness.plan.planSessionStart -> project.specs 'reads spec, deck, feedback state' { style { line dashed } }
  harness.plan.deckStale -> project.specs 'compares hashes with deck/build-info.json' { style { line dashed } }
  claudeCode -> harness.plan.stepGate 'Stop'
  harness.plan.stepGate -> project.specs 'hashes prd.md, spec.md, model' { style { line dashed } }
  harness.plan.stepGate -> harness.core.recordVerdict 'reads the verdicts it wrote' { style { line dashed } }
  harness.plan.deckDiagrammer -> harness.plan.model 'runs views, deck'
  harness.plan.model -> project.specs 'reads model/, writes deck/diagram.src.json' 
  harness.plan.present -> harness.plan.visualQa 'dispatches'
  harness.plan.present -> project.specs 'writes deck/build-info.json'
  harness.plan.deckNarrator -> project.specs 'writes deck/narrative.json'
  harness.plan.deckDiagrammer -> project.specs 'writes deck/diagram.src.json'
  harness.plan.build -> project.specs 'writes deck/deck.json, deck/index.html'
  harness.plan.visualQa -> harness.plan.build 'runs'
  harness.plan.visualQa -> harness.plan.qa 'runs'
  harness.plan.visualQa -> project.specs 'edits deck JSON'
  harness.plan.qa -> chromium 'screenshots via'
  harness.plan.qa -> project.specs 'writes deck/qa/'

  // Design review
  harness.plan.designReview -> harness.plan.lenses 'dispatches in parallel'
  harness.plan.designReview -> harness.ops.securityAuditor 'dispatches (security lens)'
  harness.plan.designReview -> project.specs 'writes feedback.md'
  harness.plan.lenses -> project.specs 'reads prd.md, spec.md' { style { line dashed } }
}
