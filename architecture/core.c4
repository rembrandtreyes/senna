// plugins/core: guardrails, session context, and the task workflow
model {
  extend harness {
    core = service 'core plugin' {
      description 'Every project: session context, guardrails, handoffs, retro loop, task workflow'
      technology 'bash hooks, markdown'
      link ../plugins/core 'code'

      // Hooks
      sessionStart = component 'session-start.sh' {
        description 'Prints mode, stack, git state, current task, latest handoff, and learnings as context'
        technology 'SessionStart hook'
        link ../plugins/core/hooks/scripts/session-start.sh 'code'
      }
      guards = component 'guard-bash.sh / guard-files.sh' {
        description 'Blocks destructive commands and secret-file access (exit 2)'
        technology 'PreToolUse hooks'
        link ../plugins/core/hooks/scripts/guard-bash.sh 'code'
      }
      progressLog = component 'progress-log.sh' {
        description 'Strict modes only: appends one line per tool call'
        technology 'PostToolUse hook'
        link ../plugins/core/hooks/scripts/progress-log.sh 'code'
      }
      preCompact = component 'pre-compact.sh' {
        description 'Writes a mechanical handoff snapshot before compaction'
        technology 'PreCompact hook'
        link ../plugins/core/hooks/scripts/pre-compact.sh 'code'
      }
      notify = component 'notify.sh' {
        description 'Desktop notification, plus an ntfy.sh push if configured'
        technology 'Notification hook'
        link ../plugins/core/hooks/scripts/notify.sh 'code'
      }
      recordVerdict = component 'record-verdict.sh' {
        description 'When a critic or reviewer finishes, records its VERDICT with the hash of what it reviewed'
        technology 'SubagentStop hook'
        link ../plugins/core/hooks/scripts/record-verdict.sh 'code'
      }
      reviewGate = component 'review-gate.sh' {
        description 'Blocks the stop once when the current task is in review or done without a reviewer verdict'
        technology 'Stop hook'
        link ../plugins/core/hooks/scripts/review-gate.sh 'code'
      }
      boundaryCheck = component 'boundary-check.sh' {
        description 'Warns (never blocks) when a project-defined boundary changed and no real-dependency test did'
        technology 'Stop hook'
        link ../plugins/core/hooks/scripts/boundary-check.sh 'code'
      }

      // Commands and skills
      breakdown = component '/breakdown' {
        description 'Turns an idea, plan, or approved spec into task files; spec tasks carry milestone R-IDs'
        technology 'command'
        link ../plugins/core/commands/breakdown.md 'code'
      }
      worktree = component '/worktree + worktree.sh' {
        description 'One git worktree per independent task: env copied, port slot, deps, mode=parallel'
        technology 'command, bash'
        link ../plugins/core/scripts/worktree.sh 'code'
      }
      ridCheck = component 'rid-check.sh' {
        description 'Fails a task whose R-IDs no changed test cites'
        technology 'bash, git'
        link ../plugins/core/scripts/rid-check.sh 'code'
      }
      ship = component '/ship' {
        description 'Runs checks, dispatches reviewers, fixes blockers, commits, opens the PR'
        technology 'command'
        link ../plugins/core/commands/ship.md 'code'
      }
      handoff = component '/handoff' {
        description 'Writes a human-readable handoff for the next session'
        technology 'command'
        link ../plugins/core/commands/handoff.md 'code'
      }
      retro = component '/retro' {
        description 'Captures lessons; proposes promoting recurring ones to a hook or skill'
        technology 'command'
        link ../plugins/core/commands/retro.md 'code'
      }
      architecture = component 'architecture skill' {
        description 'Reads, bootstraps, and checks the LikeC4 model in architecture/'
        technology 'skill'
        link ../plugins/core/skills/architecture/SKILL.md 'code'
      }
      testing = component 'testing skill' {
        description 'Rubric for what to test, at which layer, and what verifies each mock'
        technology 'skill'
        link ../plugins/core/skills/testing/SKILL.md 'code'
      }
      testAudit = component '/test-audit' {
        description 'Classifies recent fix commits by cause and cheapest catching layer; recommends where to invest'
        technology 'skill'
        link ../plugins/core/skills/test-audit/SKILL.md 'code'
      }

      // Subagents
      explorer = component 'explorer' {
        description 'Read-only scout; returns a file:line map'
        technology 'subagent'
        link ../plugins/core/agents/explorer.md 'code'
      }
      reviewer = component 'reviewer' {
        description 'Adversarial review of the diff against acceptance criteria, R-ID tests, and the spec'
        technology 'subagent'
        link ../plugins/core/agents/reviewer.md 'code'
      }
      debugger = component 'debugger' {
        description 'Reproduces, fixes minimally, and leaves a regression test'
        technology 'subagent'
        link ../plugins/core/agents/debugger.md 'code'
      }
    }
  }

  // Hook events
  claudeCode -> harness.core.sessionStart 'SessionStart'
  claudeCode -> harness.core.guards 'PreToolUse (Bash, Read/Edit/Write)'
  claudeCode -> harness.core.progressLog 'PostToolUse' { style { line dashed } }
  claudeCode -> harness.core.preCompact 'PreCompact'
  claudeCode -> harness.core.notify 'Notification' { style { line dashed } }
  claudeCode -> harness.core.boundaryCheck 'Stop'
  claudeCode -> harness.core.recordVerdict 'SubagentStop'
  claudeCode -> harness.core.reviewGate 'Stop'
  harness.core.recordVerdict -> project.harnessState 'writes verdicts/<subject>'
  harness.core.reviewGate -> project.harnessState 'reads current-task and verdicts' { style { line dashed } }
  harness.core.reviewGate -> harness.core.reviewer 'asks Claude to run' { style { line dashed } }
  harness.core.boundaryCheck -> project.harnessState 'reads checks/boundaries.txt' { style { line dashed } }
  harness.core.boundaryCheck -> project.workTree 'reads changed files' { style { line dashed } }

  // Commands
  claudeCode -> harness.core.breakdown '/breakdown'
  claudeCode -> harness.core.worktree '/worktree'
  claudeCode -> harness.core.ship '/ship'
  claudeCode -> harness.core.handoff '/handoff'
  claudeCode -> harness.core.retro '/retro'
  claudeCode -> harness.core.architecture '/architecture, or on cross-service questions'
  claudeCode -> harness.core.testing 'writing, fixing, or reviewing tests; every bug fix'
  claudeCode -> harness.core.testAudit '/test-audit, or quarterly via /retro'
  harness.core.testAudit -> harness.core.explorer 'dispatches (batches of commits)'
  harness.core.testAudit -> project.harnessState 'writes test-audit-<date>.md'
  harness.core.retro -> harness.core.testAudit 'suggests quarterly' { style { line dashed } }
  harness.core.reviewer -> harness.core.testing 'grades the diff\'s tests against the rubric'
  claudeCode -> harness.core.debugger 'bugs and failing tests'

  // State
  harness.core.sessionStart -> project.harnessState 'reads mode, current-task, handoffs, learnings, ports.env' { style { line dashed } }
  harness.core.sessionStart -> project.workTree 'reads git status' { style { line dashed } }
  harness.core.guards -> project.harnessState 'reads blocked-commands.txt, mode' { style { line dashed } }
  harness.core.progressLog -> project.harnessState 'appends progress.log'
  harness.core.preCompact -> project.harnessState 'writes handoff-auto.md'
  harness.core.notify -> ntfy 'POST alert'
  harness.core.breakdown -> project.tasks 'writes T-NNN.md'
  harness.core.breakdown -> project.harnessState 'writes current-task'
  harness.core.breakdown -> harness.core.explorer 'dispatches'
  harness.core.worktree -> project.workTree 'git worktree add'
  harness.core.worktree -> project.harnessState 'writes mode=parallel, ports.env, current-task'
  harness.core.ship -> harness.core.reviewer 'dispatches'
  harness.core.ship -> harness.ops.securityAuditor 'dispatches (if installed)'
  harness.core.ship -> project.tasks 'updates status'
  harness.core.ship -> project.workTree 'commits'
  harness.core.ship -> github 'gh pr create'
  harness.core.handoff -> project.harnessState 'writes handoff.md'
  harness.core.retro -> project.harnessState 'writes learnings.md'
  harness.core.architecture -> harness.core.explorer 'dispatches (init)'
  harness.core.reviewer -> project.tasks 'reads acceptance criteria' { style { line dashed } }
  harness.core.reviewer -> harness.core.ridCheck 'runs for tasks with Requirements:'
  harness.core.ridCheck -> project.workTree 'greps changed tests for R-IDs' { style { line dashed } }
  harness.core.breakdown -> project.specs 'reads milestones, coverage table' { style { line dashed } }
  harness.core.reviewer -> project.workTree 'reads git diff' { style { line dashed } }
}
